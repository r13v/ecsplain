{
	"name": "ecsplain",
	"version": "1.0.0",
	"description": "A small typed Entity Component System with scoped React subscriptions.",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"import": "./dist/react/index.js"
		},
		"./package.json": "./package.json"
	},
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsup && tsc -p tsconfig.build.json",
		"build:examples": "npm run build:table && npm run build:form && npm run build:invoice",
		"build:form": "vite build examples/dynamic-form --config vite.config.ts",
		"build:invoice": "vite build examples/invoice-approval --config vite.config.ts",
		"build:table": "vite build examples/table --config vite.config.ts",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"dev:form": "vite examples/dynamic-form --config vite.config.ts",
		"dev:invoice": "vite examples/invoice-approval --config vite.config.ts",
		"dev:table": "vite examples/table --config vite.config.ts",
		"knip": "knip",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"validate": "npm run check && npm run typecheck && npm test && npm run build && npm run build:examples && npm run knip"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/r13v/ecsplain.git"
	},
	"keywords": [
		"ecs",
		"react",
		"typescript"
	],
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/r13v/ecsplain/issues"
	},
	"homepage": "https://github.com/r13v/ecsplain#readme",
	"peerDependencies": {
		"react": "^19.2.0"
	},
	"overrides": {
		"esbuild": "^0.28.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@playwright/test": "^1.62.0",
		"@tanstack/react-query": "5.101.4",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"jsdom": "^29.1.1",
		"knip": "^6.29.0",
		"msw": "2.15.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tsup": "^8.5.1",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	},
	"msw": {
		"workerDirectory": [
			"examples/invoice-approval/public"
		]
	}
}
